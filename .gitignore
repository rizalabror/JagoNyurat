# ----------------------------
# Environment Files
# ----------------------------
# Jangan pernah push .env karena mengandung data sensitif
.env
.env.*
.env_local
!.env.example

# ----------------------------
# CodeIgniter 4 - Writable
# ----------------------------
writable/cache/*
!writable/cache/index.html

writable/logs/*
!writable/logs/index.html

writable/session/*
!writable/session/index.html

writable/uploads/*
!writable/uploads/index.html

writable/debugbar/*
!writable/debugbar/.gitkeep

php_errors.log

# ----------------------------
# Composer
# ----------------------------
vendor/

# ----------------------------
# Node / NPM
# ----------------------------
node_modules/
npm-debug.log
yarn-error.log

# ----------------------------
# Temporary / IDE Files
# ----------------------------
temporary/
.idea/
*.iml
.vscode/
*.suo
*.user

# ----------------------------
# OS Files
# ----------------------------
.DS_Store
Thumbs.db
Desktop.ini
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ----------------------------
# Logs
# ----------------------------
*.log
